{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/experience", "destination": "/experience.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/writing", "destination": "/writing.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:route(projects|experience|contact|writing).html", "destination": "/:route", "permanent": true }
  ],
  "headers": [
    {
      "source": "/writing",
      "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:route(projects|experience|contact|writing).html", "destination": "/:route", "permanent": true }
  ],
  "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
